.vscode/

# metadados gerados pelo C2 (regeneraveis com c2 start)
*.c2.json

# configuracao do workspace C2 (especifica da maquina; c2 init regenera)

# cache do runtime baixado por scripts/fetch-runtime.ps1
/build/

# scripts temporarios de patch
scripts/pf_*.py

# estado local do C2 (config, logs, cache, pid) - por maquina
