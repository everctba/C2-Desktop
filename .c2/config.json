{
  "schema_version": 1,
  "model": {
    "name": "local-model",
    "path": null,
    "port": 8080,
    "ctx_size": 8192,
    "threads": 0,
    "gpu_layers": 0,
    "temperature": 0.2,
    "timeout_secs": 120,
    "max_retries": 2
  },
  "index": {
    "max_file_bytes": 262144,
    "extensions": [
      "rs",
      "toml",
      "lock",
      "json",
      "jsonl",
      "md",
      "txt",
      "sh",
      "bash",
      "ps1",
      "bat",
      "cmd",
      "py",
      "js",
      "mjs",
      "cjs",
      "ts",
      "tsx",
      "jsx",
      "vue",
      "svelte",
      "html",
      "htm",
      "css",
      "scss",
      "less",
      "sql",
      "yml",
      "yaml",
      "xml",
      "ini",
      "cfg",
      "conf",
      "env",
      "c",
      "h",
      "cpp",
      "hpp",
      "cc",
      "go",
      "java",
      "kt",
      "kts",
      "cs",
      "rb",
      "php",
      "lua",
      "swift",
      "ex",
      "exs",
      "erl",
      "hs",
      "ml",
      "scala",
      "dart",
      "zig",
      "nim",
      "r",
      "jl",
      "pl",
      "tf",
      "hcl",
      "proto",
      "graphql"
    ],
    "excluded_dirs": [
      ".git",
      ".beads",
      ".c2",
      "node_modules",
      "target",
      "dist",
      "build",
      "out",
      "__pycache__",
      ".venv",
      "venv",
      "vendor",
      ".idea",
      ".vscode"
    ],
    "respect_gitignore": true,
    "max_links_per_file": 64
  },
  "engine": {
    "poll_interval_secs": 5,
    "batch_size": 0
  }
}
